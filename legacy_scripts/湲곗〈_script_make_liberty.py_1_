 #       f_liberty_out.write("      vomin : %0.5f ;\n" % data_UDC["low_vmin"])
 #       f_liberty_out.write("   }\n")
    if "input_voltage" in data_template_lib:
        for input_voltage in data_template_lib["input_voltage"]:
            f_liberty_out.write("   input_voltage(%s) {\n" % input_voltage["param"])
            f_liberty_out.write("      vil   : %0.5f ;\n" % input_voltage["vil"])
            f_liberty_out.write("      vih   : %0.5f ;\n" % input_voltage["vih"])
            f_liberty_out.write("      vimax : %0.5f ;\n" % input_voltage["vimax"])
            f_liberty_out.write("      vimin : %0.5f ;\n" % input_voltage["vimin"])
            f_liberty_out.write("   }\n")
    else:
        print("ERROR: input_voltage is not in template liberty!")
        sys.exit()
    
    if "output_voltage" in data_template_lib:
        for output_voltage in data_template_lib["output_voltage"]:
            f_liberty_out.write("   output_voltage(%s) {\n" % output_voltage["param"])
            f_liberty_out.write("      vol   : %0.5f ;\n" % output_voltage["vol"])
            f_liberty_out.write("      voh   : %0.5f ;\n" % output_voltage["voh"])
            f_liberty_out.write("      vomax : %0.5f ;\n" % output_voltage["vomax"])
            f_liberty_out.write("      vomin : %0.5f ;\n" % output_voltage["vomin"])
            f_liberty_out.write("   }\n")
    else:
        print("ERROR: input_voltage is not in template liberty!")
        sys.exit()
    #input/output voltage end
    
    f_liberty_out.write("\n")
    
    #hard coding for k factor
    #Should the k-factor be determined here?
    if True:
        f_liberty_out.write("/* Global k factor for cell delay and transition */\n")   
        f_liberty_out.write("\n")   
        f_liberty_out.write("      k_process_cell_rise : 1.0000000 ;\n")   
        f_liberty_out.write("      k_process_cell_fall : 1.0000000 ;\n")   
        f_liberty_out.write("      k_process_rise_transition : 1.0000000 ;\n")   
        f_liberty_out.write("      k_process_fall_transition : 1.0000000 ;\n")   
        f_liberty_out.write("      k_temp_cell_rise          : 0.0000000 ;\n")   
        f_liberty_out.write("      k_temp_cell_fall          : 0.0000000 ;\n")   
        f_liberty_out.write("      k_temp_rise_transition    : 0.0000000 ;\n")   
        f_liberty_out.write("      k_temp_fall_transition    : 0.0000000 ;\n")   
        f_liberty_out.write("      k_volt_cell_rise          : 0.0000000 ;\n")   
        f_liberty_out.write("      k_volt_cell_fall          : 0.0000000 ;\n")   
        f_liberty_out.write("      k_volt_rise_transition    : 0.0000000 ;\n")   
        f_liberty_out.write("      k_volt_fall_transition    : 0.0000000 ;\n")   
        f_liberty_out.write(" \n")   
        f_liberty_out.write("/* Global k factor for hazard */\n")   
        f_liberty_out.write("\n")   
        f_liberty_out.write("      k_process_setup_rise      : 1.0000000 ;\n")
        f_liberty_out.write("      k_process_setup_fall      : 1.0000000 ;\n")
        f_liberty_out.write("      k_process_hold_rise       : 1.0000000 ;\n")
        f_liberty_out.write("      k_process_hold_fall       : 1.0000000 ;\n")
        f_liberty_out.write("      k_temp_setup_rise         : 0.0000000 ;\n")
        f_liberty_out.write("      k_temp_setup_fall         : 0.0000000 ;\n")
        f_liberty_out.write("      k_temp_hold_rise          : 0.0000000 ;\n")
        f_liberty_out.write("      k_temp_hold_fall          : 0.0000000 ;\n")
        f_liberty_out.write("      k_volt_setup_rise         : 0.0000000 ;\n")
        f_liberty_out.write("      k_volt_setup_fall         : 0.0000000 ;\n")
        f_liberty_out.write("      k_volt_hold_rise          : 0.0000000 ;\n")
        f_liberty_out.write("      k_volt_hold_fall          : 0.0000000 ;\n")
        f_liberty_out.write("      k_process_recovery_rise   : 1.0000000 ;\n")
        f_liberty_out.write("      k_process_recovery_fall   : 1.0000000 ;\n")
        f_liberty_out.write("      k_temp_recovery_rise      : 0.0000000 ;\n")
        f_liberty_out.write("      k_temp_recovery_fall      : 0.0000000 ;\n")
        f_liberty_out.write("      k_volt_recovery_rise      : 0.0000000 ;\n")
        f_liberty_out.write("      k_volt_recovery_fall      : 0.0000000 ;\n")
        f_liberty_out.write("      k_process_removal_rise    : 1.0000000 ;\n")
        f_liberty_out.write("      k_process_removal_fall    : 1.0000000 ;\n")
        f_liberty_out.write("      k_temp_removal_rise       : 0.0000000 ;\n")
        f_liberty_out.write("      k_temp_removal_fall       : 0.0000000 ;\n")
        f_liberty_out.write("      k_volt_removal_rise       : 0.0000000 ;\n")
        f_liberty_out.write("      k_volt_removal_fall       : 0.0000000 ;\n")
        f_liberty_out.write("      k_process_min_pulse_width_high : 1.0000000 ;\n")
        f_liberty_out.write("      k_process_min_pulse_width_low  : 1.0000000 ;\n")
        f_liberty_out.write("      k_temp_min_pulse_width_high    : 0.0000000 ;\n")
        f_liberty_out.write("      k_temp_min_pulse_width_low     : 0.0000000 ;\n")
        f_liberty_out.write("      k_volt_min_pulse_width_high    : 0.0000000 ;\n")
        f_liberty_out.write("      k_volt_min_pulse_width_low     : 0.0000000 ;\n")
        f_liberty_out.write("\n")
        f_liberty_out.write("/* Global k factor for wire */\n")
        f_liberty_out.write("\n")
        f_liberty_out.write("    k_process_wire_res   : 0.0000000;\n")
        f_liberty_out.write("    k_volt_wire_res      : 0.0000000;\n")
        f_liberty_out.write("    k_temp_wire_res      : 0.0000000;\n")
        f_liberty_out.write("\n")
        f_liberty_out.write("    k_process_wire_cap   : 0.0000000;\n")
        f_liberty_out.write("    k_volt_wire_cap      : 0.0000000;\n")
        f_liberty_out.write("    k_temp_wire_cap      : 0.0000000;\n")
        f_liberty_out.write("\n")
    #k-factor end
    
    #write type_bus
    for type_bus_name in data_UDC["type_bus"]:
        f_liberty_out.write("   type({type_bus}_{cell_name}) {{\n" .format(type_bus=type_bus_name, cell_name=data_UDC["cell_name"]))
        f_liberty_out.write("       base_type : array;\n")#hard coding
        f_liberty_out.write("       data_type : bit;\n")#hard coding
        f_liberty_out.write("       bit_width : %d;\n" % data_UDC["type_bus"][type_bus_name]["bit_width"])
        f_liberty_out.write("       bit_from  : %d;\n" % data_UDC["type_bus"][type_bus_name]["bit_from"])
        f_liberty_out.write("       bit_to    : %d;\n" % data_UDC["type_bus"][type_bus_name]["bit_to"]) 
        f_liberty_out.write("       downto    : true;\n")#hard coding
        f_liberty_out.write("   }\n")
    
    #find table index with parameter name "<cell_name>_out"
    table_index_out = {}
    for table_index in data_UDC["table_index"]:
        if table_index["parameter"][:len(data_UDC["cell_name"])] == data_UDC["cell_name"]:
            if table_index["parameter"][len(data_UDC["cell_name"])+1:] == "out":
                table_index_out = table_index.copy()
        
    if not table_index_out:  print("ERROR: there is NO table_index with paramter name \"<cell_name>_out\" in UDC file")
    #table_index=table_index_out
    #genenrally table_index=data_UDC["table_index"][2]["parameter"]
    f_liberty_out.write("   lu_table_template ({cell_name}_{table_index}) {{\n" .format(cell_name=data_UDC["cell_name"], table_index=table_index_out["parameter"]))   
    udc_y_index_var = ""
    udc_x_index_var = ""
    
    if table_index_out["y_index_var"] == "input_slope": udc_y_index_var = "input_net_transition"
    if table_index_out["x_index_var"] == "output_load_cap": udc_x_index_var = "total_output_net_capacitance"
    f_liberty_out.write("      variable_1 : {var1} ;\n" .format(var1=udc_y_index_var))   #correct?
    f_liberty_out.write("      variable_2 : {var2} ;\n" .format(var2=udc_x_index_var))   #correct?
    f_liberty_out.write("      index_1 (\"%0.5f ,%0.5f ,%0.5f ,%0.5f ,%0.5f \");\n" % (table_index_out["y_index"][0], table_index_out["y_index"][1], table_index_out["y_index"][2], table_index_out["y_index"][3], table_index_out["y_index"][4]))
    f_liberty_out.write("      index_2 (\"%0.5f ,%0.5f ,%0.5f ,%0.5f ,%0.5f \");\n" % (table_index_out["x_index"][0], table_index_out["x_index"][1], table_index_out["x_index"][2], table_index_out["x_index"][3], table_index_out["x_index"][4]))
    f_liberty_out.write("   }\n")   
    f_liberty_out.write("\n")   
    
    f_liberty_out.write(" cell ({cell_name}) {{\n" .format(cell_name=data_UDC["cell_name"]))   
    f_liberty_out.write("   {process_prefix}_class : {_class};\n" .format(process_prefix=process_prefix, _class=data_UDC["class"]))
    f_liberty_out.write("   {process_prefix}_cell_type   : {cell_type};\n" .format(process_prefix=process_prefix, cell_type=data_UDC["cell_type"]))
    f_liberty_out.write("   area : %0.5f;\n" % data_UDC["area"])
    f_liberty_out.write("   %s_width : %0.5f;\n" % (process_prefix, data_UDC["width"]))
    f_liberty_out.write("   %s_height : %0.5f;\n" % (process_prefix, data_UDC["height"]))
    
    f_liberty_out.write("   dont_use   : true;\n")   #hard coding
    f_liberty_out.write("   dont_touch : true;\n")   #hard coding
    
    #Add for loop?
    f_liberty_out.write("   %s_voltage : \"%0.5f\" ;\n" % (process_prefix, data_UDC["timing_derating"][1]["nom_voltage"]))
    f_liberty_out.write("   %s_temperature : \"%0.5f\" ;\n" % (process_prefix, data_UDC["timing_derating"][1]["nom_temperature"]))
    
    f_liberty_out.write("   cell_leakage_power  : 00.00000000000000000000;\n")      #hard coding
