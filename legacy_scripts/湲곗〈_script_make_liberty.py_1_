        f_liberty_out.write("   %s_default_delay_calculation : false;\n" % process_prefix) #need to check
        f_liberty_out.write("   %s_default_unit_area_cell : %s;\n" % (process_prefix, data_template_lib["sec_default_unit_area_cell"])) #need to check
        f_liberty_out.write("   %s_default_connection_class : internal;\n" % process_prefix) #need to check
        f_liberty_out.write("   %s_default_multi_vdd_new_kit : true;\n" % process_prefix) #need to check
        f_liberty_out.write("\n")
        f_liberty_out.write("   define(%s_class, cell, string);\n" % process_prefix)
        f_liberty_out.write("   define(%s_cell_type, cell, string);\n" % process_prefix)
        f_liberty_out.write("   define(%s_weak_fn_delay, cell, float);\n" % process_prefix)
        f_liberty_out.write("   define(%s_external_voltage_type, cell, string);\n" % process_prefix)
        f_liberty_out.write("   define(%s_width, cell, float);\n" % process_prefix)
        f_liberty_out.write("   define(%s_height, cell, float);\n" % process_prefix)
        f_liberty_out.write("\n")
        f_liberty_out.write("   define(%s_pin_type, pin, string);\n" % process_prefix)
        f_liberty_out.write("   define(%s_driver_type, pin, string);\n" % process_prefix)
        f_liberty_out.write("\n")
        f_liberty_out.write("   define(%s_function, pin, string);\n" % process_prefix)
        f_liberty_out.write("\n")
        f_liberty_out.write("   define_group(%s_pdt_pin, cell);\n" % process_prefix)
        f_liberty_out.write("   define(%s_pdt_power_class, cell, string);\n" % process_prefix)
        f_liberty_out.write("   define(%s_pdt_voltage, cell, float);\n" % process_prefix)
        f_liberty_out.write("   define(%s_pdt_power_driver, cell, string);\n" % process_prefix)
        f_liberty_out.write("   define(%s_pdt_cell_prop, cell, string);\n" % process_prefix)
        f_liberty_out.write("   define(%s_pdt_supplied_port, %s_pdt_pin, string);\n" % (process_prefix, process_prefix))
        f_liberty_out.write("   define(%s_pdt_pin_type, %s_pdt_pin, string);\n" % (process_prefix, process_prefix))
        f_liberty_out.write("   define(%s_pdt_power_type, %s_pdt_pin, string);\n" % (process_prefix, process_prefix))
        f_liberty_out.write("   define(%s_pdt_related_pin, %s_pdt_pin, string);\n" % (process_prefix, process_prefix))
        f_liberty_out.write("   define(%s_pdt_supplied_port, pin, string);\n" % process_prefix)
        f_liberty_out.write("   define(%s_pdt_pin_type, pin, string);\n" % process_prefix)
        f_liberty_out.write("   define(%s_pdt_power_type, pin, string);\n" % process_prefix)
        f_liberty_out.write("   define(%s_pdt_related_pin, pin, string);\n" % process_prefix)
        f_liberty_out.write("   define_group(%s_acore_internal_power, pin);\n" % process_prefix)
        f_liberty_out.write("   define(%s_acore_rise_power, %s_acore_internal_power, float);\n" % (process_prefix, process_prefix))
        f_liberty_out.write("   define(%s_acore_fall_power, %s_acore_internal_power, float);\n" % (process_prefix, process_prefix))
        f_liberty_out.write("   define(%s_acore_power, %s_acore_internal_power, float);\n" % (process_prefix, process_prefix))
        f_liberty_out.write("   define(%s_acore_when, %s_acore_internal_power, string);\n" % (process_prefix, process_prefix))
        f_liberty_out.write("   define(\"%s_voltage\", \"cell\", \"string\");\n" % process_prefix)
        f_liberty_out.write("   define(\"%s_temperature\", \"cell\", \"string\");\n" % process_prefix)
        f_liberty_out.write("   define(%s_esd_generated_power, pin, float);\n" % process_prefix)
        f_liberty_out.write("\n")
    
    #write voltage map
    f_liberty_out.write("")

    #sorting types of pg_pin information start
    pg_pin_values = []
    for split_pg_line in data_pg_pin:
        pg_voltage_value = float(split_pg_line[2].split('_')[1])
        if pg_voltage_value not in pg_pin_values:
            pg_pin_values.append(pg_voltage_value)
        
    #sorting types of pg_pin information end
    
    if data_UDC["low_vmax"] in pg_pin_values:
        f_liberty_out.write("   voltage_map (VDD_%0.5f, %0.5f) ;\n" % (data_UDC["low_vmax"], data_UDC["low_vmax"]))
    if data_UDC["high_vmax"] in pg_pin_values:
        f_liberty_out.write("   voltage_map (VDD_%0.5f, %0.5f) ;\n" % (data_UDC["high_vmax"], data_UDC["high_vmax"]))
    if data_UDC["middle_vmax"] in pg_pin_values:
        f_liberty_out.write("   voltage_map (VDD_%0.5f, %0.5f) ;\n" % (data_UDC["middle_vmax"], data_UDC["middle_vmax"]))
    if data_UDC["low_vmin"] in pg_pin_values:
        f_liberty_out.write("   voltage_map (VSS_%0.5f, %0.5f) ;\n" % (data_UDC["low_vmin"], data_UDC["low_vmin"]))
    f_liberty_out.write("\n")
    f_liberty_out.write("\n")
    #argument pass end
    f_liberty_out.write("   operating_conditions ({library})  {{\n" .format(library=data_UDC["lib_name"].upper())) #is argument correct?
    f_liberty_out.write("       process    	 : 1.000 ;\n") #timing_process_cond?
    #add for loop for timing derating?
    f_liberty_out.write("       temperature	 : %0.3f ;\n" % data_UDC["timing_derating"][1]["nom_temperature"])#is argument correct?
    f_liberty_out.write("       voltage    	 : %0.5f ;\n" % data_UDC["timing_derating"][1]["nom_voltage"])#is argument correct?
    f_liberty_out.write("       tree_type  	 : \"worst_case_tree\" ;\n") #fixed value? or it mean min timing process condition?
    f_liberty_out.write("   }\n")
    f_liberty_out.write("   default_operating_conditions : {library};\n" .format(library=data_UDC["lib_name"].upper()))
    f_liberty_out.write("\n")
    #need to check the cases where various input/output voltage types are used
 #   if True:
