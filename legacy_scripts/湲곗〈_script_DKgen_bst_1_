sub port_def
{
	printf "	Port description save as ... ";
	$fileName2 = $cell_name;
	$fileName2 =~ s/atop_//g;
	$fileName2 = "./UDC_RESULT/".$fileName2."_port_v".$fileVersionInt.".".$fileVersionFrac.".txt";
	open ($fileHandle, "> $fileName2") or die "Cannot open $fileName2 : $!";
	
	foreach $vlist (@port_array){
		@array = split(/(,)/, $vlist);
		foreach $m (2 .. ($maxcol) *2)	{
			next if ($m%2 == 1);
			#warning("*Warning 3 >> detected empty cell in $array[4] line") unless defined ($array[$m]);
			warning("*Warning 3 >> detected empty or \"-\" data cell in 2 ~ 13 column @ $array[4] line") 
					if ($array[$m] eq "-")&&(($m > 1)&&($m < 13*2));
			printf $fileHandle $array[$m]."\t" unless ($m == $maxcol*2);
			printf $fileHandle $array[$m] if ($m == $maxcol*2);
		}
		printf $fileHandle "\n";
	}
	close $fileHandle;
	printf "$fileName2\n\n";
}

