sub pdt_gen
{
	printf "	pdt file save as ... ";
	$fileName4 = "./UDC_RESULT/".$cell_name.".pdt";
	open ($fileHandle, "> $fileName4") or die "Cannot open $fileName4 : $!";

	my $pdt_header_format = 
		"//*****************************************************************************\n".
		"//\tDevice Name\t: $cell_name\n".
		"//\n".
		"//\tFile Type\t\t: Verilog RTL\n".
		"//\tFile Name\t\t: $fileName4\n".
		"//\tModule Name\t: $cell_name\n".
		"//\tObject\t\t: $cell_name hardmacro\n".
		#"//\tVer\t\t\t: $DKgen_ver\n".
		"//\tVer\t\t\t: 0.0\n".
		"//\tDate\t\t\t: %s\n".
		"//\n".
		"//   Modify Descriptions\n".
		"//   +------Date-------------+ver--------+By------------+Descriptions----------\n".
		#"//   \t%s\t\t\t$DKgen_ver\t\t$g_username\t\tInitial Version\n".
		"//       %s\t\t\t0.0\t\t$g_username\t\tInitial Version\n".
		"//*****************************************************************************\n\n".
		"cell ( $cell_name ) {\n";
	#($sec,$min,$hour,$mday,$mon,$year,$wday,$yday,$isdst) = localtime(time); $year+=1900;
	#printf $fileHandle $pdt_header_format, scalar localtime,"$year-$mon-$mday";
	@local_time = localtime(time); $local_time[5]+=1900; $local_time[4]+=1;
	printf $fileHandle $pdt_header_format, scalar localtime,"$local_time[5]-$local_time[4]-$local_time[3]";
	#printf "@local_time\n\n";

	foreach $vlist (@pwr_array){
		@array = split(/(,)/, $vlist);
		@portName = $array[4] =~ /\w+/g;
		$related_pin = "";
		foreach $port_list (@port_array)	{
			@array2 = split(/(,)/, $port_list);
			@relatedPower = $array2[9*2] =~ /\w+/g;
			@portName2 = $array2[2*2] =~ /\w+/g;
			if ($portName[0] eq $relatedPower[0])	{
				$div_sign = ", ";	$div_sign = "" if ($related_pin eq "");
				$related_pin .= $div_sign.$portName2[0];
			}
		}
		$related_pin = "\t\trelated_pin : $related_pin;\n" unless ($related_pin eq "");
		printf $fileHandle "\tpin( $portName[0] ){\n".
						"\t\torder : $lastpinnum ;\n".$related_pin.
						"\t\tpin_type : power ;\n\t}\n";
		$lastpinnum++;
	}	
	foreach $vlist (@gnd_array){
		@array = split(/(,)/, $vlist);
		@portName = $array[4] =~ /\w+/g;
		$related_pin = "";
		foreach $port_list (@port_array)	{
			@array2 = split(/(,)/, $port_list);
			@relatedGround = $array2[10*2] =~ /\w+/g;
			@portName2 = $array2[2*2] =~ /\w+/g;
			if ($portName[0] eq $relatedGround[0])	{
				$div_sign = ", ";	$div_sign = "" if ($related_pin eq "");
				$related_pin .= $div_sign.$portName2[0];
			}
		}
		$related_pin = "\t\trelated_pin : $related_pin;\n" unless ($related_pin eq "");
		printf $fileHandle "\tpin( $portName[0] ){\n".
						"\t\torder : $lastpinnum ;\n".$related_pin.
						"\t\tpin_type : ground ;\n\t}\n";
		$lastpinnum++;
	}
	printf $fileHandle "}\n";
	close $fileHandle;
	printf "$fileName4\n\n";
}


