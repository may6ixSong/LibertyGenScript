################
##  ATOP RTL  ##
################

sub atop_rtl
{
	printf "	Atop RTL save as ... ";
	$fileName3 = "./UDC_RESULT/".$cell_name.".v";
	open ($fileHandle, "> $fileName3") or die "Cannot open $fileName3 : $!";

	printf $fileHandle "`timescale 1ns/1ps\n\n";
	printf $fileHandle "module $cell_name(\n";
	foreach $vlist (@port_array){
		@array = split(/(,)/, $vlist);
		@portName = $array[4] =~ /\w+/g;
		if ($vlist eq $port_array[$#port_array])	{printf $fileHandle "\t\t".$portName[0]."\n";}
		else	{printf $fileHandle "\t\t".$portName[0].",\n";}
	}
	#printf $fileHandle ");\n//CLK\n";
	printf $fileHandle ");\n";
	foreach $vlist (@port_array){
		@array = split(/(,)/, $vlist);
		($MSB, $LSB) = $array[4] =~ /(\d+):(\d+)/;
		@BIT = $array[6] =~ /\d+/g;
		warning("*Warning 1 >> difference bitwidth between Name & Bits in $array[4] line".
				"// [$MSB:$LSB] != $BIT[0]\n\n") if ($BIT[0]!=1)&&($MSB-$LSB+1 != $BIT[0]);
		@portName = $array[4] =~ /\w+/g;
		@inoutref = $array[10] =~ /\w+/g;
		if ($inoutref[0] eq "I")	{$inout = "input\t";}
		elsif ($inoutref[0] eq "O")	{$inout = "output\t";}
		elsif ($inoutref[0] eq "IO")	{$inout = "inout\t";}
		else	{error("*Error 4 >> invalid port I/O info in $array[4] line"); $inout = "";}
		if ((defined $MSB) and (defined $LSB))	{$bitwidth = "[$MSB:$LSB]\t";}
		elsif ($BIT[0]>1)	{$bitwidth = "[$BIT[0]:0\t";}
		else	{$bitwidth = "\t\t";}
		if ($array[0] =~ /\w+/) {printf $fileHandle "//".$array[0]."\n";}
		printf $fileHandle $inout.$bitwidth.$portName[0].";\n";
	}
	printf $fileHandle "\n";
	foreach $vlist (@pwr_array){
		@array = split(/(,)/, $vlist);
		@portName = $array[4] =~ /\w+/g;
		printf $fileHandle "supply1\t$portName[0];\n";
	}	
	foreach $vlist (@gnd_array){
		@array = split(/(,)/, $vlist);
		@portName = $array[4] =~ /\w+/g;
		printf $fileHandle "supply0\t$portName[0];\n";
	}
	printf $fileHandle "\nendmodule";
	close $fileHandle;
	printf "$fileName3\n\n";
}
		

