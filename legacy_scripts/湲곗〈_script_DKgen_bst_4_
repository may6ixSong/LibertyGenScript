sub pg_pin_gen
{
	printf "	pg_pin file save as ... \n";
	@pg_pin_condition = ("bst", "wst");

	foreach $m (0 .. $#pg_pin_condition)	{
		$fileName6 = "./UDC_RESULT/"."pg_pin_".$pg_pin_condition[$m];
		open ($fileHandle, "> $fileName6") or die "Cannot open $fileName6 : $!";

		foreach $vlist (@pwr_array)	{
			@array = split(/(,)/, $vlist);
			@portName = $array[2*2] =~ /\w+/g;
			@volts = $array[6*2] =~ /\S+/g;
			# v0.86
			#if ($volts[0] eq "3.3V")	{
			#	printf $fileHandle "default	$portName[0]		VDD_3.60000	primary_power\n"
			#			if ($pg_pin_condition[$m] eq "bst");
			#	printf $fileHandle "default	$portName[0]		VDD_3.00000	primary_power\n"
			#			if ($pg_pin_condition[$m] eq "wst");
			#}
			#elsif ($volts[0] eq "1.2V")	{
			#	printf $fileHandle "default	$portName[0]		VDD_1.32000	primary_power\n"
			#			if ($pg_pin_condition[$m] eq "bst");
			#	printf $fileHandle "default	$portName[0]		VDD_1.08000	primary_power\n"
			#			if ($pg_pin_condition[$m] eq "wst");
			#}
			if ($volts[0] eq $high_voltage_level)	{
				printf $fileHandle "default	$portName[0]		VDD_$high_vmax_bst"."000	primary_power\n"
						if ($pg_pin_condition[$m] eq "bst");
				printf $fileHandle "default	$portName[0]		VDD_$high_vmax_wst"."000	primary_power\n"
						if ($pg_pin_condition[$m] eq "wst");
			}
			elsif ($volts[0] eq $mid_voltage_level)	{
				printf $fileHandle "default	$portName[0]		VDD_$mid_vmax_bst"."000	primary_power\n"
						if ($pg_pin_condition[$m] eq "bst");
				printf $fileHandle "default	$portName[0]		VDD_$mid_vmax_wst"."000	primary_power\n"
						if ($pg_pin_condition[$m] eq "wst");
			}
			elsif ($volts[0] eq $low_voltage_level)	{
				printf $fileHandle "default	$portName[0]		VDD_$low_vmax_bst"."000	primary_power\n"
						if ($pg_pin_condition[$m] eq "bst");
				printf $fileHandle "default	$portName[0]		VDD_$low_vmax_wst"."000	primary_power\n"
						if ($pg_pin_condition[$m] eq "wst");
			}
		}
		foreach $vlist (@gnd_array)	{
			@array = split(/(,)/, $vlist);
			@portName = $array[2*2] =~ /\w+/g;
			@volts = $array[6*2] =~ /\S+/g;
			if ($volts[0] eq "0V")	{
				printf $fileHandle "default	$portName[0]		VSS_0.00000	primary_ground\n"
						if ($pg_pin_condition[$m] eq "bst");
				printf $fileHandle "default	$portName[0]		VSS_0.00000	primary_ground\n"
						if ($pg_pin_condition[$m] eq "wst");
			}
			elsif ($volts[0] eq "-1.2V")	{
				printf $fileHandle "default	$portName[0]		VSS_0.00000	primary_ground\n"
						if ($pg_pin_condition[$m] eq "bst");
				printf $fileHandle "default	$portName[0]		VSS_0.00000	primary_ground\n"
						if ($pg_pin_condition[$m] eq "wst");
			}
		}

		printf "\t\t\t     $fileName6\n";
		close $fileHandle;
	}
	printf "\n";
}


sub read_excel
{
	open ($fileHandle, "$fileName") or die "Cannot open $fileName : $!";
	$oBook = Spreadsheet::ParseExcel::Workbook->Parse($fileName) 
	  		or die "Could not open source Excel file $fileName: $!";
	$sheets = $oBook->{SheetCount};

	if ($sheets < 1)	{
		#printf "\n*Error >> Invalid input file\n\n";
		error ("*Error 1 >> Invalid input file");
		complete(0);
	}

	foreach $sheet (0 .. $sheets-1) {
	    	$oSheet = $oBook->{Worksheet}[$sheet];
	    	$sheetName = $oSheet->{Name};
	    	next unless (exists ($oSheet->{MaxRow}) and (exists ($oSheet->{MaxCol})));
		#next unless ($sheetName =~ /port|Port|PORT|UDC/);
		if ($sheetName =~ /port|Port|PORT/)	{
		    	foreach $row ($oSheet->{MinRow} .. $oSheet->{MaxRow}) {
		    	    	#foreach $column ($oSheet->{MinCol} .. $oSheet->{MaxCol}) {
					next unless (defined $oSheet->{Cells}[$row][0]);
					if (($oSheet->{Cells}[$row][0]->Value =~ /atop_/) or
						($oSheet->{Cells}[$row][0]->Value =~ /aps_/)	or
						($oSheet->{Cells}[$row][0]->Value =~ /ATOP_/))	{
						$devicerow = $row;
						#$devicecol = $column;
					}
			}
			#$cell_name = $oSheet->{Cells}[$devicerow][$devicecol]->Value;
			#$cell_name = $cell_name;
			$maxcol = 15; $lastpinnum = 1;
		    	#foreach $row ($devicerow+2 .. $udcrow-1) {
		    	foreach $row ($devicerow+2 .. $oSheet->{MaxRow}) {
					next unless (defined $oSheet->{Cells}[$row][1]);
					$vlist = "";
		    	    foreach $column (0 .. $maxcol)	{# $oSheet->{MaxCol}) {
						if ($column == 14)	{
							$vlist = $vlist."-,";
						}
		         		elsif ((defined $oSheet->{Cells}[$row][$column])
						&&($oSheet->{Cells}[$row][$column] =~ /\w/g))	{
							$vlist = $vlist.$oSheet->{Cells}[$row][$column]->Value.",";
		        		} else {
							$vlist = $vlist."-,";
		         		}
		        	}
				if ($oSheet->{Cells}[$row][1]->Value =~ /PORT/)	{
					@array = split(/(,)/, $vlist);
					# v0.86
					#push @clk_array, $array[2*2] if ($oSheet->{Cells}[$row][2]->Value =~ /CLK$/)
					#					    or ($oSheet->{Cells}[$row][2]->Value =~ /CLK_E$/)
					#					    or ($oSheet->{Cells}[$row][2]->Value =~ /CLK_O$/);
					push @clk_array, $array[2*2] if ($oSheet->{Cells}[$row][15]->Value =~ /clock/);
					push @port_array, $vlist;
					#$lastpinnum = $oSheet->{Cells}[$row][4]->Value if 
					#		($oSheet->{Cells}[$row][4]->Value > $lastpinnum);
					$lastpinnum = $oSheet->{Cells}[$row][3]->Value + $oSheet->{Cells}[$row][4]->Value ;
				}
				elsif ($oSheet->{Cells}[$row][1]->Value =~ /PWR/)	{
					$PWR_PORT_name = $oSheet->{Cells}[$row][2]->Value;
					warning("*Warning 4 >> PORT(PWR) & I/O description is unmatched in $PWR_PORT_name line -- Deleted in power array") 
							unless ($oSheet->{Cells}[$row][5]->Value =~ /P|p/);
					push @pwr_array, $vlist
							if ($oSheet->{Cells}[$row][5]->Value =~ /P|p/);
				}
				elsif ($oSheet->{Cells}[$row][1]->Value =~ /GND/)	{
					$GND_PORT_name = $oSheet->{Cells}[$row][2]->Value;
					warning("*Warning 4 >> PORT(GND) & I/O description is unmatched in $GND_PORT_name line -- Deleted in ground array") 
							unless ($oSheet->{Cells}[$row][5]->Value =~ /G|g/);
					push @gnd_array, $vlist
							if ($oSheet->{Cells}[$row][5]->Value =~ /G|g/);
				}
				else	{}
		    	}
		}
		elsif ($sheetName =~ /UDC_GEN/)	{
			#@first_index = ("UDC_GEN_BST", "UDC_GEN_TIV", "UDC_GEN_WST");
			$first_index = "UDC_GEN_".$constraint_CAP;
			#foreach $m (0 .. 2)	{
			foreach $m (0 .. 0)	{
				#$firstindex = $first_index[$m];
				$firstindex = $first_index;
				$escape = 0;


				foreach $row ($oSheet->{MinRow} .. $oSheet->{MaxRow}) {
		    	    		foreach $column ($oSheet->{MinCol} .. $oSheet->{MaxCol}) {
						next unless (defined $oSheet->{Cells}[$row][$column]);
						if ($oSheet->{Cells}[$row][$column]->Value =~ /$firstindex/)	{
							$FirstRow = $row;
							$FirstCol = $column;
							$escape = 1;
							last;
						}
					}
					last if ($escape);
				}

				foreach $udc_row ($FirstRow .. $oSheet->{MaxRow})	{
					next unless (defined $oSheet->{Cells}[$udc_row][$FirstCol]);
					next unless (defined $oSheet->{Cells}[$udc_row][$FirstCol+1]);
					$cell_index = $oSheet->{Cells}[$udc_row][$FirstCol]->Value;
					$cell_value = $oSheet->{Cells}[$udc_row][$FirstCol+1]->Value;
					#printf "$cell_index // $cell_value	\n";
					$area[$m] = $cell_value if ($cell_index =~ /area/);
					$width[$m] = $cell_value if ($cell_index =~ /width/);
					$height[$m] = $cell_value if ($cell_index =~ /height/);
					$static_current[$m] = $cell_value if ($cell_index =~ /static_current/);
					$cell_name[$m] = $cell_value if ($cell_index =~ /cell/);
					$library_name[$m] = $cell_value if ($cell_index =~ /library_name/);
					$MC_timing_state[$m] = $cell_value if ($cell_index =~ /MC_timing_state/);
					$HDA_timing_state[$m] = $cell_value if ($cell_index =~ /HDA_timing_state/);
					$OUT_timing_state[$m] = $cell_value if ($cell_index =~ /OUT_timing_state/);
					#$capacitance[$m] = $cell_value if ($cell_index =~ /capacitance/);
					$nom_voltage[$m] = $cell_value if ($cell_index =~ /nom_voltage/);
					$nom_temperature[$m] = $cell_value if ($cell_index =~ /nom_temperature/);
					$case1_temp[$m] = $cell_value if ($cell_index =~ /case1_temp/);
					$case1_volt[$m] = $cell_value if ($cell_index =~ /case1_volt/);
					$case1_value[$m] = $cell_value if ($cell_index =~ /case1_value/);
					$case2_temp[$m] = $cell_value if ($cell_index =~ /case2_temp/);
					$case2_volt[$m] = $cell_value if ($cell_index =~ /case2_volt/);
					$case2_value[$m] = $cell_value if ($cell_index =~ /case2_value/);
					$case3_temp[$m] = $cell_value if ($cell_index =~ /case3_temp/);
					$case3_volt[$m] = $cell_value if ($cell_index =~ /case3_volt/);
					$case3_value[$m] = $cell_value if ($cell_index =~ /case3_value/);
					$case4_temp[$m] = $cell_value if ($cell_index =~ /case4_temp/);
					$case4_volt[$m] = $cell_value if ($cell_index =~ /case4_volt/);
					$case4_value[$m] = $cell_value if ($cell_index =~ /case4_value/);
					#printf "$Tsetup[$m] // $Thold[$m]\n";
				}
			}
		}
		elsif ($sheetName =~ /UDC_timing/)	{
			@first_index = ("Output", "Input");
#			$Output_Y_index = 5;
#			$Output_X_index = 5;
			$Output_Y_index = 8;
			$Output_X_index = 8;
			$Input_Y_index = 3;
			$Input_X_index = 3;
			foreach $m (0 .. 1)	{
				$firstindex = $first_index[$m];
				$escape = 0;

				foreach $row ($oSheet->{MinRow} .. $oSheet->{MaxRow}) {
		    	    		foreach $column ($oSheet->{MinCol} .. $oSheet->{MaxCol}) {
						next unless (defined $oSheet->{Cells}[$row][$column]);
						if ($oSheet->{Cells}[$row][$column]->Value =~ /$firstindex/)	{
							$FirstRow = $row;
							$FirstCol = $column;
							$escape = 1;
							last;
						}
					}
					last if ($escape);
				}
				
				if ($m == 0)	{
					foreach $j (0 .. $Output_Y_index-1)	{
						$OUT_y[$j] = $oSheet->{Cells}[$FirstRow][$FirstCol+4+$j]->Value;
					}
					foreach $j (0 .. $Output_X_index-1)	{
						$OUT_x[$j] = $oSheet->{Cells}[$FirstRow+1][$FirstCol+4+$j]->Value;
					}
				}
				elsif ($m == 1)	{
					foreach $j (0 .. $Input_Y_index-1)	{
						$IN_y_setup[$j] = $oSheet->{Cells}[$FirstRow][$FirstCol+4+$j]->Value;
						#$IN_y_hold[$j] = $oSheet->{Cells}[$FirstRow+2][$FirstCol+4+$j]->Value;
					}
					foreach $j (0 .. $Input_X_index-1)	{
						$IN_x_setup[$j] = $oSheet->{Cells}[$FirstRow+1][$FirstCol+4+$j]->Value;
						#$IN_x_hold[$j] = $oSheet->{Cells}[$FirstRow+3][$FirstCol+4+$j]->Value;
					}
				}
			}
		}
	
		$cell_name = $cell_name[0];
	}
	close $fileHandle;
}


sub read_mt_out
{
	$mt_out_file_name = $_[0];
	$mt_out_argument = $_[1];
	chomp ($mt_out_file_name);
	chomp ($mt_out_argument);

	open (FILE,$mt_out_file_name)||die "cannot open \"$mt_out_file_name\"\n";
	@mtarr = <FILE>;
	close FILE;
	while (1)	{
		$vlist = shift @mtarr;
		chomp ($vlist);
		@array = $vlist =~ /\w+/g;
		if ($array[0] eq "index") {
			unshift @mtarr, $vlist."\n";
			last;
		}
	}
		
	#shift @mtarr; #-works for finesim & hspice
	$mtstr = "@mtarr";
	chomp($mtstr);

	## processing headers (@mt_head = measurement list)
	#if($mtstr =~ m/^\s+/s){
	#	$mtstr = $2
	#}

	if($mtstr =~ m/(.*)alter/s){
		@mt_head = split /\s+/,$1;
		#print @mt_head;
		if ($mt_head[0] eq ''){
			shift @mt_head;
		}	
		push @mt_head, 'alter';
	}

	$mt_head_dbug = 15; $cnt = 0;
	foreach $mt_head (@mt_head)	{
		if ($mt_head =~ /tphl/)	{
			$htol_num = $cnt;
			$mt_head_dbug -= 1;
		}
		elsif ($mt_head =~ /tplh/)	{
			$ltoh_num = $cnt;
			$mt_head_dbug -= 2;
		}
		elsif ($mt_head =~ /tr/)	{
			$tr_num = $cnt;
			$mt_head_dbug -= 4;
		}
		elsif ($mt_head =~ /tf/)	{
			$tf_num = $cnt;
			$mt_head_dbug -= 8;
		}
		$cnt++;
	}
	if ($mt_head_dbug)	{
		$mt_head_dbug_bin = DecToNumBase ($mt_head_dbug, 2, 4);
		@mt_head_dbug_bin_array = $mt_head_dbug_bin =~ /\d/g;
		if ($mt_head_dbug_bin_array[3]){
			error("*Error 6 >> Need to more measured data (tphl)");
		}
		elsif ($mt_head_dbug_bin_array[2]){
			error("*Error 6 >> Need to more measured data (tplh)");
		}
		elsif ($mt_head_dbug_bin_array[1]){
			error("*Error 6 >> Need to more measured data (tr)");
		}
		elsif ($mt_head_dbug_bin_array[0]){
			error("*Error 6 >> Need to more measured data (tf)");
		}
		complete(0);
	}

	## parsing selections ########################################################
	@mt_sel = ();
	for($i=0;$i<=$#mt_head;$i++){
		@mt_sel = (@mt_sel,$i);
	}

	## Data Processing ###########################################################
	#if($mtstr =~ m/^\s+/s){
	#	$mtstr = $2
	#}
	if($mtstr =~ m/alter#(.*)/s){
		@mt_data = split /\s+/,$1;
		#print @mt_data;
		if ($mt_data[0] eq ''){
			shift @mt_data;
		}
	}
	$mt_index = ($#mt_data+1) / ($#mt_head+1);
	#printf "\t$#mt_sel\t@mt_sel\t$mt_index\t$#mt_data\t$#mt_head\n\n";

	$aLine = "";
	foreach(@mt_sel){
	     #printf " %10s ", $mt_head[$_];
	     #push @mt_array, "\t".$mt_head[$_];
	     $aLine .= "          ".$mt_head[$_];
		#printf "\t$_\t$mt_head[$_]\n";
	}
	#push @mt_array, "\n";
	@mt_out_array = ();
	push @mt_out_array, $aLine;

	$aLine = "";
	for($i=0; $i < $mt_index; $i++){
		if (not( $mt_data[$i*($#mt_head+1)] =~ m/^[a-z]/s)){
	        foreach(@mt_sel){	
	               $value = $mt_data[$i*($#mt_head+1)+$_];
	               $aLine .= "\t".$value;
			}
	    	push @mt_out_array, $aLine;
		$aLine = "";
		}
	}
	if ($mt_make)	{
		{open ($mtHandle, "> ./UDC_RESULT/$mt_out_argument.dat") or die "Cannot open $mt_out_argument.dat : $!";}
		foreach $vlist (@mt_out_array){
			printf $mtHandle $vlist."\n";
		}
		close $mtHandle;
	}
	return @mt_out_array;
}

