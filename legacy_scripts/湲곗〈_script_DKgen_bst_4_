sub DecToNumBase
	{
	$decNumber = $_[0];
	$numBase = $_[1];
	$totNumber = $_[2];
	$numNumber = '';
	$numcnt = 0;

	while($decNumber ne 'end') 
		{
	    # divide the decimal number by $numBase and 
	    # store the remainder (modulus function) in 
	    # the temporary variable $temp
		$numcnt++;
	    	my $temp = $decNumber % $numBase;
		
	    	if($temp > 9) 
	    		{
	      		$temp = chr($temp + 55);
	    	}
	    	$numNumber = $temp . $numNumber;
	   	$decNumber = int($decNumber / $numBase);
	   	
	    	if($decNumber < $numBase) 
	    		{
      			if($decNumber > 9) 
      				{
        			$decNumber = chr($decNumber + 55);
      			}
      			$numNumber = $decNumber . $numNumber;
      			$decNumber = 'end'; 
    		} 
  	}
	unless ($totNumber == 0)
		{
	  	if ($numcnt < $totNumber - 1)
  			{
  			foreach (1 .. $totNumber - $numcnt - 1)
  				{
  				$numNumber = '0' . $numNumber;
	  		}
  		}
  	}

  	return $numNumber;
}

sub RoundXL {
	sprintf("%.$_[1]f", $_[0]);
}

sub ExToReal	{
	my @expo_num = $_[0] =~ /(\d+.\d+)+e([\+,\-])(\d+)/g;
	my $real_num;

	if ($2 eq "+")	{
		$real_num = $1*(10**($3+9));
	}
	elsif ($2 eq "-") {
		$real_num = $1/(10**($3-9));
	}

	$real_num_temp = &RoundXL($real_num, 4);
	#printf "\norigin_num : $_[0] // expo_num : $1 $2 $3 // $real_num_temp";
	return $real_num_temp;
}